# N8N Configuration
# Generate a new encryption key: openssl rand -hex 32
N8N_ENCRYPTION_KEY=your_encryption_key_here
# Hostname for n8n (used for webhooks and external access)
N8N_HOST=your-n8n-domain.com
# Set to true when using HTTPS
N8N_SECURE_COOKIE=true

# HTTPS-Portal Configuration
# Format: DOMAINS=domain.com -> http://n8n:5678
# Multiple domains: DOMAINS=domain1.com -> http://n8n:5678, domain2.com -> http://n8n:5678
DOMAINS=your-domain.com -> http://n8n:5678

# SSL Certificate Stage
# - local: For local development (self-signed certificate)
# - staging: For testing (Let's Encrypt staging environment)
# - production: For production (Let's Encrypt production environment)
STAGE=staging

# Maximum file upload size
# Examples: 10M, 100M, 1G
CLIENT_MAX_BODY_SIZE=100M