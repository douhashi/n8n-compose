# N8N Configuration
# Generate a new encryption key: openssl rand -hex 32
N8N_ENCRYPTION_KEY=your_encryption_key_here
# Hostname for n8n (used for webhooks and external access)
N8N_HOST=your-n8n-domain.com
# Set to true when using HTTPS
N8N_SECURE_COOKIE=true
# Webhook URL for external access (usually https://{N8N_HOST})
WEBHOOK_URL=https://your-n8n-domain.com

N8N_DEFAULT_BINARY_DATA_MODE=filesystem
N8N_DEFAULT_BINARY_DATA_MODE=/home/node/files

# HTTPS-Portal Configuration
# Format: DOMAINS=domain.com -> http://n8n:5678
# Multiple domains: DOMAINS=domain1.com -> http://n8n:5678, domain2.com -> http://n8n:5678
DOMAINS=your-n8n-domain.com -> http://n8n:5678

# SSL Certificate Stage
# - local: For local development (self-signed certificate)
# - staging: For testing (Let's Encrypt staging environment)
# - production: For production (Let's Encrypt production environment)
STAGE=production

# Maximum file upload size
# Examples: 10M, 100M, 1G
CLIENT_MAX_BODY_SIZE=100M

# Enable WebSocket support for real-time features
WEBSOCKET=true

# Tailscale Configuration
# Get your auth key from https://login.tailscale.com/admin/settings/keys
# Use a reusable key for persistent deployments
TS_AUTHKEY=your_tailscale_auth_key_here

# Postgresql
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=password

